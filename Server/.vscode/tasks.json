{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build server",
            "type": "shell",
            "command": "E:/Qt/5.14.2/mingw73_64/bin/qmake.exe",
            "args": [
                "Server.pro",
                "-spec",
                "win32-g++",
                "CONFIG+=debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Server"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "make Server",
            "type": "shell",
            "command": "mingw32-make",
            "options": {
                "cwd": "${workspaceFolder}/Server"
            },
            "problemMatcher": "$gcc"
        }
    ]
}
