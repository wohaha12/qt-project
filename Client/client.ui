   <string notr="true">/* QQ风格Qt样式表 */
QMainWindow, QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #1E90FF, stop:0.5 #00BFFF, stop:1 #87CEEB);
    font-family: &quot;Microsoft YaHei&quot;, &quot;Segoe UI&quot;, sans-serif;
}

QWidget#centralWidget {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 15px;
    margin: 20px;
    border: 1px solid #E0E0E0;
}

QLabel {
    color: #333333;
    font-size: 14px;
    padding: 5px;
}

QLineEdit {
    border: 2px solid #E0E0E0;
    border-radius: 20px;
    padding: 10px 15px;
    font-size: 14px;
    background: #FFFFFF;
    selection-background-color: #1E90FF;
    min-height: 25px;
}

QLineEdit:focus {
    border-color: #1E90FF;
    background: #F0F8FF;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4DA6FF, stop:1 #1E90FF);
    border: none;
    border-radius: 20px;
    color: white;
    font-size: 14px;
    font-weight: bold;
    padding: 10px 20px;
    min-height: 35px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5CB0FF, stop:1 #2D9CFF);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3D96FF, stop:1 #0D80FF);
}

/* 注册按钮特殊样式 */
QPushButton[text=&quot;注册&quot;] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #FF9500, stop:1 #FF7F00);
}

QPushButton[text=&quot;注册&quot;]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #FFA533, stop:1 #FF8C1A);
}

QPushButton[text=&quot;注册&quot;]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #E68500, stop:1 #CC6A00);
}

/* 登录按钮特殊样式 */
QPushButton[text=&quot;登录&quot;] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #00CD00, stop:1 #00B200);
}

QPushButton[text=&quot;登录&quot;]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #00E600, stop:1 #00CC00);
}

QPushButton[text=&quot;登录&quot;]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #00B200, stop:1 #009900);
}</string>
